# Copy to .dev.vars for LOCAL development, not to a public repository.
# Local mock identity is seedy@sites.test; published owner email is configured separately.
ADMIN_EMAIL=seedy@sites.test
APP_ORIGIN=http://localhost:5173
# For Telegram, generate your own local 32-byte key as 64 hexadecimal characters.
# Do not copy or replace the production encryption key.
TELEGRAM_SECRET_KEY=
# Enter bot token only in the authenticated admin setup form.
